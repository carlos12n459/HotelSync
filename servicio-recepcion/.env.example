PORT=3003

DB_HOST=localhost
DB_PORT=5432
DB_USER=hotelsync_app
DB_PASSWORD=hotelsync_app_pass
DB_NAME=recepcion_db

# RabbitMQ para eventos asincronos
# Consume: booking.created
# Publica: checkout.completed, booking.completed
RABBITMQ_URL=amqp://hotelsync:hotelsync_pass@localhost:5672

# URL del servicio de reservas, usada para la consulta SINCRONA de la reserva.
URL_SERVICIO_RESERVAS=http://localhost:3002

# URL del servicio de housekeeping, usada para la consulta SINCRONA del
# estado de limpieza de la habitacion antes de hacer check-in.
URL_SERVICIO_HOUSEKEEPING=http://localhost:3004
