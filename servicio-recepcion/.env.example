PORT=3003

DB_HOST=localhost
DB_PORT=3306
DB_USER=hotelsync_app
DB_PASSWORD=hotelsync_app_pass
DB_NAME=recepcion_db

# URL del servicio de reservas, usada para:
# - la consulta SÍNCRONA de la reserva del día al iniciar turno / check-in
# - el polling de eventos ASÍNCRONOS booking.created (reemplaza a RabbitMQ)
URL_SERVICIO_RESERVAS=http://localhost:3002
INTERVALO_POLLING_MS=4000

# URL del servicio de housekeeping, usada para la consulta SÍNCRONA del
# estado de limpieza de la habitación antes de hacer check-in.
URL_SERVICIO_HOUSEKEEPING=http://localhost:3004
