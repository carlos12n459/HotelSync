PORT=3007

DB_HOST=localhost
DB_PORT=3306
DB_USER=hotelsync_app
DB_PASSWORD=hotelsync_app_pass
DB_NAME=facturacion_db

# URL del servicio de reservas, usada para consultar SINCRONICAMENTE los
# datos de la reserva al crear un folio (por polling de checkout.completed).
URL_SERVICIO_RESERVAS=http://localhost:3002

# URL del servicio de recepcion, usada para el polling ASINCRONO del evento
# checkout.completed que se publica en el outbox de recepcion.
URL_SERVICIO_RECEPCION=http://localhost:3003

INTERVALO_POLLING_MS=4000
