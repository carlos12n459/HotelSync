PORT=3007

DB_HOST=localhost
DB_PORT=5432
DB_USER=hotelsync_app
DB_PASSWORD=hotelsync_app_pass
DB_NAME=facturacion_db

# RabbitMQ para eventos asincronos
# Consume: checkout.completed
# Publica (opcional): charge.added, payment.processed
RABBITMQ_URL=amqp://hotelsync:hotelsync_pass@localhost:5672

# URL del servicio de reservas, usada para consultar SINCRONICAMENTE los
# datos de la reserva al crear un folio.
URL_SERVICIO_RESERVAS=http://localhost:3002

# URL del servicio de recepcion (legacy).
URL_SERVICIO_RECEPCION=http://localhost:3003
