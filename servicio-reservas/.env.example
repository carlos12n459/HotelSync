PORT=3002

DB_HOST=localhost
DB_PORT=5432
DB_USER=hotelsync_app
DB_PASSWORD=hotelsync_app_pass
DB_NAME=reservas_db

# RabbitMQ para eventos asincronos (booking.created, booking.cancelled)
RABBITMQ_URL=amqp://hotelsync:hotelsync_pass@localhost:5672

# URL del microservicio de disponibilidad y tarifas, usada para la
# comunicacion SINCRONA (bloqueo de inventario antes de confirmar).
URL_SERVICIO_DISPONIBILIDAD=http://localhost:3001

# URL del servicio de propiedades (catalogo maestro).
URL_SERVICIO_PROPIEDADES=http://localhost:3005
