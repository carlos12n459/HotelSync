PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=hotelsync_app
DB_PASSWORD=hotelsync_app_pass
DB_NAME=disponibilidad_tarifas_db

# Redis para cache de disponibilidad
REDIS_URL=redis://localhost:6379

# RabbitMQ para eventos asincronos (availability.updated)
RABBITMQ_URL=amqp://hotelsync:hotelsync_pass@localhost:5672

# URL del servicio de reservas, usada para la comunicacion sincrona de bloqueo/liberacion.
URL_SERVICIO_RESERVAS=http://localhost:3002

# URL del servicio de propiedades (catalogo maestro).
URL_SERVICIO_PROPIEDADES=http://localhost:3005
